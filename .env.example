# =============================================================================
# Real-Time Market Events Stream — .env.example
# Copy this file to .env and fill in your values. NEVER commit .env
# =============================================================================

# --- Application ---
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO

# --- CoinGecko API ---
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_WS_URL=wss://your_coingecko_ws_url_here

# --- Polygon.io API ---
POLYGON_API_KEY=your_polygon_api_key_here
POLYGON_WS_URL=wss://delayed.polygon.io/stocks

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_CRYPTO=market.events.crypto
KAFKA_TOPIC_FOREX=market.events.forex
KAFKA_TOPIC_STOCKS=market.events.stocks
KAFKA_TOPIC_DLQ=market.events.dlq
KAFKA_GROUP_ID=market-events-consumer-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT  # PLAINTEXT | SSL | SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=                # PLAIN | SCRAM-SHA-256 (leave empty for local)
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Schema Registry (optional) ---
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- TimescaleDB / PostgreSQL ---
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=market_events
TIMESCALE_USER=postgres
TIMESCALE_PASSWORD=your_timescale_password_here
TIMESCALE_SCHEMA=public
DATABASE_URL=postgresql://postgres:your_timescale_password_here@localhost:5432/market_events

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your_secret_key_here

# --- Airflow ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your_timescale_password_here@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__WEBSERVER__SECRET_KEY=your_webserver_secret_here

# --- Google Cloud Storage (optional archive) ---
GCS_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here
GRAFANA_PORT=3000
